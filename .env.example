# ── OpenAI ─────────────────────────────────────────────
# platform.openai.com 에서 발급한 API 키. 비워 두면 목업 모드로 동작합니다.
OPENAI_API_KEY=
# 비전 검수 + 답변 모델 (이미지 입력과 image_generation 도구를 지원하는 모델)
OPENAI_MODEL=gpt-6.1-terra
# 런너 시안 이미지 생성 설정 (비우면 기본값)
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1536x1024

# ── 서버 ───────────────────────────────────────────────
PORT=3100
# 키가 있어도 true 로 두면 목업 모드 (비용 없이 UI 확인)
MOCK_AI=false
